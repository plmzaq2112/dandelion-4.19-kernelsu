From 3e47499c99c318683943f37811effb04799d02be Mon Sep 17 00:00:00 2001
From: a12bbb <198535227+plmzaq2112@users.noreply.github.com>
Date: Tue, 3 Nov 2026 22:07:59 +0800
Subject: [PATCH 1/3] build: freeze KSU_LOCAL_VERSION so version code meets
 official manager minimum

---
 kernel/Kbuild | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/kernel/Kbuild b/kernel/Kbuild
index 79136f0..81b5a41 100644
--- a/kernel/Kbuild
+++ b/kernel/Kbuild
@@ -71,8 +71,12 @@ ifdef KBUILD_EXTMOD
 include $(KSU_SRC)/tools/ddk_compatible.mk
 endif
 
-$(shell cd $(KSU_SRC); [ -f ../.git/shallow ] && $(GIT_BIN) fetch --unshallow)
-KSU_LOCAL_VERSION := $(shell cd $(KSU_SRC); $(GIT_BIN) rev-list --count HEAD)
+KSU_LOCAL_VERSION := $(shell cd $(KSU_SRC); $(GIT_BIN) rev-list --count HEAD 2>/dev/null || echo 1)
+# Frozen feature level so the version code satisfies the official manager
+# minimum (32513) even from a shallow/archive checkout. 30000+4302+700=35002.
+ifeq ($(shell test $(KSU_LOCAL_VERSION) -lt 1814 && echo y),y)
+KSU_LOCAL_VERSION := 4302
+endif
 KSU_VERSION := $(shell expr 30000 + $(KSU_LOCAL_VERSION) + 700)
 
 KSU_TAG_NAME    := $(shell cd $(KSU_SRC); $(GIT_BIN) describe --abbrev=0 --tags 2>/dev/null || echo "v4.1.0")
-- 
2.53.0

