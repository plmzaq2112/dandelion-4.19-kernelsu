# SPDX-License-Identifier: GPL-2.0
#
# ksu.config —— KernelSU 线（bakasu 分支）配置差量片段
#
# 用法：先 make blossom_defconfig，再把这个片段追加进 .config，最后
#       olddefconfig 重新解析并跑断言（全部由 build-tools/build_ksu.sh 一条龙执行）。
#       不要手工编辑 out/.config，那是一次性生成物。
#
# 基准：v65 实测内核快照（release v65 与其 out/.config逐项一致）。
# KSU 源码路径: drivers/kernelsu/（BakaSU manual hook 栈，Kbuild 冻结版本号）。
# SUSFS：评估搁档（research/susfs-evaluation.md），保持关闭。
#
# [KSU 核心] manual hook 模式 —— 不依赖 KPROBES（本设备 KPROBES 关）
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y
# 多管理器签名共存（tiann 官方 + BakaSU + KOWSU）
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y
CONFIG_KSU_FULL_NAME_FORMAT="%REPO_NAME%-%COMMIT_SHA%"
# KSU 本体调试项保持关闭（v65 实测口径）
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_TOOLKIT_SUPPORT is not set
# CONFIG_KSU_TRACEPOINT_HOOK is not set
# CONFIG_KSU_SUSFS is not set
#
# [内核侧支撑] 模块系统（ksud 模块功能需要）+ 完整符号表（v65 实测 =y）
CONFIG_MODULES=y
CONFIG_KALLSYMS_ALL=y
# [版本串] 必须带（defconfig 里没有，漏掉则 UTS_RELEASE 退化为 4.19.325-dandelion）
CONFIG_LOCALVERSION="-dandelion-ksu"
